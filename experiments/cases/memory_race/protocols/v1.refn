# Refinement contracts for MemoryRace (v1.scr).
# The committed balance must be a number; the final Done value must equal the
# initial balance plus both deltas (100 + 50 + 30 = 180). These are payload-
# level guards; the stateful environment.py asserts the same balance
# independently in the world-state demonstration.

[WriterA -> MemoryStore : WriteA]
type: float
require: float(x) == 150

[WriterB -> MemoryStore : WriteB]
type: float
require: float(x) == 180

[MemoryStore -> Coordinator : Done]
type: float
require: float(x) == 180
