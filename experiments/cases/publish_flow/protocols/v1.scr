module v1;

data <java> "java.lang.String" from "rt.jar" as String;

// The typed publish channel: the only path to an irreversible outward act
// (a git push) is a message the projected gate checks before delivery.
// Payload of PushRequest is the branch name being pushed.
global protocol PublishFlow(role Agent, role Repo) {
    PushRequest(String) from Agent to Repo;
    choice at Repo {
        PushAck(String) from Repo to Agent;
    } or {
        PushRejected(String) from Repo to Agent;
    }
}
